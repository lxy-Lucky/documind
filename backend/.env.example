# ===== Ollama =====
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_QA=qwen3:14b
OLLAMA_MODEL_VL=qwen3-vl:8b
OLLAMA_TIMEOUT=300

# ===== Embedding / Reranker =====
# FastEmbed model names (auto-downloaded on first use, cached locally)
EMBED_MODEL=intfloat/multilingual-e5-large
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ===== Storage =====
DATA_DIR=./data
DB_PATH=./data/documind.db
UPLOAD_DIR=./data/uploads
SCREENSHOT_DIR=./data/screenshots
IMAGE_DIR=./data/images

# ===== Ingestion =====
# Whether to generate multi-perspective summaries per chunk (slower upload, better recall)
ENABLE_MULTI_PERSPECTIVE=true
# Concurrent LLM calls during enrichment. 14B on single GPU usually handles 4-6.
ENRICH_CONCURRENCY=4
# Skip enrichment for chunks shorter than N characters (not worth the LLM call).
ENRICH_MIN_CHARS=80
# Whether to ask VL to describe every sheet as overview chunk (slower upload)
ENABLE_VL_SHEET_OVERVIEW=true
# Render screenshots only for sheets where VL might be needed (cover/screen/unknown).
# Set false to screenshot every sheet (slower); true keeps ingestion fast.
SMART_SCREENSHOTS=true
# Hard cap on cells per sheet; sheets exceeding this are read in a degraded mode
# (text-only dump, no per-cell color tracking). Prevents pathological sheets
# (millions of empty styled cells) from stalling ingestion.
MAX_CELLS_PER_SHEET=20000
# Top-N candidates after recall, before reranker
RECALL_TOP_N=30
# Top-K after reranker, fed to LLM
RERANK_TOP_K=5

# ===== LibreOffice (for sheet screenshots) =====
# Path to soffice binary; on Linux usually "/usr/bin/soffice" or just "soffice" on PATH
LIBREOFFICE_BIN=soffice

# ===== Server =====
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
