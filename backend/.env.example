# ===== Ollama =====
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_QA=qwen3:14b
OLLAMA_MODEL_VL=qwen3-vl:8b
OLLAMA_TIMEOUT=300

# ===== Embedding / Reranker =====
# FastEmbed model names (auto-downloaded on first use, cached locally)
EMBED_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ===== Storage =====
DATA_DIR=./data
DB_PATH=./data/documind.db
UPLOAD_DIR=./data/uploads
SCREENSHOT_DIR=./data/screenshots
IMAGE_DIR=./data/images

# ===== Ingestion =====
# Whether to generate multi-perspective summaries per chunk (slower upload, better recall)
ENABLE_MULTI_PERSPECTIVE=true
# Whether to ask VL to describe every sheet as overview chunk (slower upload)
ENABLE_VL_SHEET_OVERVIEW=true
# Top-N candidates after recall, before reranker
RECALL_TOP_N=30
# Top-K after reranker, fed to LLM
RERANK_TOP_K=5

# ===== LibreOffice (for sheet screenshots) =====
# Path to soffice binary; on Linux usually "/usr/bin/soffice" or just "soffice" on PATH
LIBREOFFICE_BIN=soffice

# ===== Server =====
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
